{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"],
            "@config/*": ["./src/config/*"],
            "~/*": ["./src/assets/*"]
        }
    }
}
