---
import { MainNavigationMenu } from '@/components/common/MainNavigationMenu'
import { MobileNav } from '@/components/common/MobileNav'
import SiteFooter from '@/components/layout/SiteFooter.astro'
import SiteHeader from '@/components/layout/SiteHeader.astro'
import { navMenuConfig } from '@/config/nav-menu'
import { extractSegmentURL } from '@/lib/utils'
import BaseLayout from './BaseLayout.astro'

type Props = {
  title: string
  description?: string
  image?: string
  imageAlt?: string
  mainClass?: string
}

const segment = extractSegmentURL(Astro.url.pathname)
const {
  title,
  description,
  mainClass,
  image = `https://images.antzhu.com${Astro.url.pathname}.webp`,
  imageAlt,
  } = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
>
  <div class="relative flex min-h-screen flex-col bg-background">
    <SiteHeader>
      <MainNavigationMenu
        slot="nav-header"
        segment={segment}
        client:load
      />
      <MobileNav
        navMenu={navMenuConfig}
        segment={segment}
        slot="mobile-nav-header"
        client:load
      />
    </SiteHeader>
    <main class:list={['flex-1', mainClass]}>
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
