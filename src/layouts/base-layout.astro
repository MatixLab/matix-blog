---
import BaseHead from "@components/seo/base-head.astro"
import TailwindIndicator from '@components/dev/tailwind-indicator.astro'
import { cn } from "@utils/tv";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  bodyClass?: string;
}

const { title, description, bodyClass, image, imageAlt } = Astro.props;
---

<!doctype html>
<html lang="zh">
  <BaseHead
    title={title}
    description={description}
    image={image}
    imageAlt={imageAlt}
  />
  <body class={cn("min-h-screen bg-background", bodyClass)}>
    <slot />
    <TailwindIndicator />
  </body>
</html>
