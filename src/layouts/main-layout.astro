---
import { MobileNav } from '@components/common/MobileNav'
import RightSection from '@components/layout/right-section.astro'
import SoundEffect from '@components/shared/sound-effect.astro'
import BaseLayout from '@layouts/base-layout.astro'
import { extractSegmentURL } from '@lib/utils'
import { cn } from '@utils/tv'

type Props = {
    title: string
    description?: string
    image?: string
    imageAlt?: string
    mainClass?: string
}

const segment = extractSegmentURL(Astro.url.pathname)

let imageDefault = segment ? Astro.url.pathname : '/home'
if (imageDefault.endsWith('/')) {
    imageDefault = imageDefault.substring(0, imageDefault.lastIndexOf('/'))
}

const {
    title,
    description,
    mainClass,
    image = `https://images.antzhu.com${imageDefault}.webp`,
    imageAlt
} = Astro.props

const pageEnterTransition = {
    duration: '220ms',
    easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
    fillMode: 'both'
}

const pageExitTransition = {
    duration: '150ms',
    easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
    fillMode: 'both'
}

const pageSlideTransition = {
    backwards: {
        new: {
            ...pageEnterTransition,
            name: 'page-slide-in-backward'
        },
        old: {
            ...pageExitTransition,
            name: 'page-slide-out-backward'
        }
    },
    forwards: {
        new: {
            ...pageEnterTransition,
            name: 'page-slide-in-forward'
        },
        old: {
            ...pageExitTransition,
            name: 'page-slide-out-forward'
        }
    }
}
---

<BaseLayout title={title} description={description} image={image} imageAlt={imageAlt}>
    <div
        class={cn(
            'mx-auto flex min-h-screen flex-col lg:h-screen',
            Astro.url.pathname !== '/' && 'lg:overflow-hidden'
        )}
    >
        <div class='sticky top-0 z-100 w-full lg:hidden'>
            <MobileNav segment={segment} client:load />
        </div>
        <div
            class={cn(
                'border-line mx-auto flex w-full max-w-5xl flex-1 flex-col lg:relative lg:min-h-0 lg:flex-row lg:border-r'
            )}
        >
            <aside
                class={cn(
                    'no-scrollbar flex min-w-0 flex-1 flex-col lg:h-full lg:min-h-0',
                    'lg:border-line lg:border-x',
                    Astro.url.pathname !== '/' && 'lg:overflow-y-auto'
                )}
            >
                <main
                    class={cn('flex-1 lg:min-h-0', mainClass)}
                    data-disable-theme-toggle-transition
                    transition:animate={pageSlideTransition}
                >
                    <slot />
                </main>
            </aside>
            <RightSection />
            <SoundEffect />
        </div>
    </div>
</BaseLayout>
