---
import { MobileNav } from '@components/common/MobileNav'
import RightSection from '@components/layout/right-section.astro'
import SoundEffect from '@components/shared/sound-effect.astro'
import BaseLayout from '@layouts/base-layout.astro'
import { extractSegmentURL } from '@lib/utils'
import { cn } from '@utils/tv'

type Props = {
    title: string
    description?: string
    image?: string
    imageAlt?: string
    mainClass?: string
}

const segment = extractSegmentURL(Astro.url.pathname)

let imageDefault = segment ? Astro.url.pathname : '/home'
if (imageDefault.endsWith('/')) {
    imageDefault = imageDefault.substring(0, imageDefault.lastIndexOf('/'))
}

const {
    title,
    description,
    mainClass,
    image = `https://images.antzhu.com${imageDefault}.webp`,
    imageAlt
} = Astro.props

const pageEnterTransition = {
    duration: '220ms',
    easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
    fillMode: 'both'
}

const pageExitTransition = {
    duration: '150ms',
    easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
    fillMode: 'both'
}

const pageSlideTransition = {
    backwards: {
        new: {
            ...pageEnterTransition,
            name: 'page-slide-in-backward'
        },
        old: {
            ...pageExitTransition,
            name: 'page-slide-out-backward'
        }
    },
    forwards: {
        new: {
            ...pageEnterTransition,
            name: 'page-slide-in-forward'
        },
        old: {
            ...pageExitTransition,
            name: 'page-slide-out-forward'
        }
    }
}
---

<BaseLayout title={title} description={description} image={image} imageAlt={imageAlt}>
    <div
        class={cn(
            'mx-auto flex min-h-screen flex-col lg:h-screen',
            Astro.url.pathname !== '/' && 'lg:overflow-hidden'
        )}
    >
        <div class='sticky top-0 z-100 w-full lg:hidden'>
            <MobileNav segment={segment} client:load />
        </div>
        <div class={cn(
            'mx-auto flex w-full max-w-5xl flex-1 flex-col lg:relative lg:min-h-0 lg:flex-row lg:border-r border-line',
            'page-frame',
        )}>
            <div class='page-frame-top-lines' aria-hidden='true'>
                <div class='page-frame-top-lines__content'>
                    <div class='page-frame-top-lines__main'></div>
                    <div class='page-frame-top-lines__sidebar'></div>
                </div>
            </div>
            <aside
                class={cn(
                    'no-scrollbar flex min-w-0 flex-1 flex-col lg:h-full lg:min-h-0',
                    'lg:border-x lg:border-line',
                    Astro.url.pathname !== '/' && 'lg:overflow-y-auto'
                )}
            >
                <main
                    class={cn('flex-1 lg:min-h-0', mainClass)}
                    data-disable-theme-toggle-transition
                    transition:animate={pageSlideTransition}
                >
                    <slot />
                </main>
            </aside>
            <RightSection />
            <SoundEffect />
        </div>
    </div>
</BaseLayout>

<style>
    @media (min-width: 64rem) {

        .page-frame::before {
            position: absolute;
            z-index: 1;
            top: 0;
            left: 50%;
            width: 100vw;
            height: 1rem;
            transform: translateX(-50%);
            border-bottom: 1px solid var(--line);
            background-color: var(--background);
            content: '';
            pointer-events: none;
        }

        .page-frame-top-lines {
            position: absolute;
            inset: 0 -1px auto 0;
            z-index: 2;
            height: 1rem;
            border-right: 1px solid var(--line);
            pointer-events: none;
        }

        .page-frame-top-lines__content {
            position: absolute;
            inset: 0;
            display: flex;
        }

        .page-frame-top-lines__main {
            min-width: 0;
            flex: 1;
            border-inline: 1px solid var(--line);
        }

        .page-frame-top-lines__sidebar {
            width: 16rem;
            flex: 0 0 16rem;
        }

        .page-frame::after {
            position: absolute;
            bottom: 2.5rem;
            left: 50%;
            width: 100vw;
            height: 2rem;
            transform: translateX(-50%);
            border-block: 1px solid var(--line);
            pointer-events: none;
        }
    }
</style>
