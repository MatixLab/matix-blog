---
import MainNav from '@components/common/MainNav.astro'
import { MobileNav } from '@components/common/MobileNav'
import SiteFooter from '@components/layout/site-footer.astro'
import SiteHeader from '@components/layout/site-header.astro'
import BaseLayout from '@layouts/base-layout.astro'
import { extractSegmentURL } from '@lib/utils'
import { cn } from '@/utils/tv'
import RightSection from '@/components/layout/right-section.astro'

type Props = {
    title: string
    description?: string
    image?: string
    imageAlt?: string
    mainClass?: string
}

const segment = extractSegmentURL(Astro.url.pathname)

let imageDefault = segment ? Astro.url.pathname : '/home'
if (imageDefault.endsWith('/')) {
    imageDefault = imageDefault.substring(0, imageDefault.lastIndexOf('/'))
}

const {
    title,
    description,
    mainClass,
    image = `https://images.antzhu.com${imageDefault}.webp`,
    imageAlt
} = Astro.props
---

<BaseLayout
    title={title}
    description={description}
    image={image}
    imageAlt={imageAlt}
>
    <div class='mx-auto flex min-h-screen flex-col lg:h-screen lg:overflow-hidden'>
      <div class='mx-auto flex w-full max-w-[80rem] flex-1 flex-col  py-12 lg:flex-row lg:gap-12 lg:overflow-hidden'>
            <div class='w-full lg:hidden'>
                <MobileNav segment={segment} client:load />
            </div>

            <aside class='no-scrollbar flex min-w-0 flex-1 flex-col lg:h-full lg:overflow-y-auto'>
                <main class={cn('flex-1', mainClass)}>
                    <slot />
                </main>
            </aside>
            <RightSection/>
        </div>
        <SiteFooter />
    </div>
</BaseLayout>
