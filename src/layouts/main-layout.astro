---
import { MobileNav } from '@components/common/MobileNav'
import RightSection from '@components/layout/right-section.astro'
import SoundEffect from '@components/shared/sound-effect.astro'
import BaseLayout from '@layouts/base-layout.astro'
import { extractSegmentURL } from '@lib/utils'
import { cn } from '@utils/tv'

type Props = {
    title: string
    description?: string
    image?: string
    imageAlt?: string
    mainClass?: string
}

const segment = extractSegmentURL(Astro.url.pathname)

let imageDefault = segment ? Astro.url.pathname : '/home'
if (imageDefault.endsWith('/')) {
    imageDefault = imageDefault.substring(0, imageDefault.lastIndexOf('/'))
}

const {
    title,
    description,
    mainClass,
    image = `https://images.antzhu.com${imageDefault}.webp`,
    imageAlt
} = Astro.props
---

<BaseLayout title={title} description={description} image={image} imageAlt={imageAlt}>
    <div
        class={cn(
            'mx-auto flex min-h-screen flex-col lg:h-screen',
            Astro.url.pathname !== '/' && 'lg:overflow-hidden'
        )}
    >
        <div
            class={cn(
                'mx-auto flex w-full max-w-5xl flex-1 flex-col p-4 md:py-8 lg:flex-row lg:gap-14',
                Astro.url.pathname !== '/' && 'lg:overflow-hidden',
                Astro.url.pathname === '/' && 'home-frame'
            )}
        >
            <div class='w-full lg:hidden'>
                <MobileNav segment={segment} client:load />
            </div>

            <aside
                class={cn(
                    'no-scrollbar flex min-w-0 flex-1 flex-col lg:h-full',
                    Astro.url.pathname !== '/' && 'lg:overflow-y-auto'
                )}
            >
                <main class={cn('flex-1', mainClass)}>
                    <slot />
                </main>
            </aside>
            <RightSection />
            <SoundEffect />
        </div>
    </div>
</BaseLayout>

<style>
    @media (min-width: 64rem) {
        .home-frame {
            position: relative;
            overflow: visible;
            box-shadow:
                inset 1px 0 var(--line),
                inset -1px 0 var(--line);
        }

        .home-frame::before {
            position: absolute;
            top: 1rem;
            left: 50%;
            width: 100vw;
            height: 1px;
            transform: translateX(-50%);
            background: var(--line);
            content: '';
            pointer-events: none;
        }

        .home-frame::after {
            position: absolute;
            bottom: 2.5rem;
            left: 50%;
            width: 100vw;
            height: 2rem;
            transform: translateX(-50%);
            border-block: 1px solid var(--line);
            background: repeating-linear-gradient(
                135deg,
                transparent 0,
                transparent 4px,
                color-mix(in oklch, var(--line) 70%, transparent) 4px,
                color-mix(in oklch, var(--line) 70%, transparent) 5px
            );
            content: '';
            pointer-events: none;
        }
    }
</style>
