---
import { MobileNav } from '@components/common/MobileNav'
import RightSection from '@components/layout/right-section.astro'
import SoundEffect from '@components/shared/sound-effect.astro'
import BaseLayout from '@layouts/base-layout.astro'
import { extractSegmentURL } from '@lib/utils'
import { cn } from '@lib/tv'

type Props = {
    title: string
    description?: string
    image?: string
    imageAlt?: string
    mainClass?: string
}

const segment = extractSegmentURL(Astro.url.pathname)

let imageDefault = segment ? Astro.url.pathname : '/home'
if (imageDefault.endsWith('/')) {
    imageDefault = imageDefault.substring(0, imageDefault.lastIndexOf('/'))
}

const {
    title,
    description,
    mainClass,
    image = `https://images.antzhu.com${imageDefault}.webp`,
    imageAlt
} = Astro.props
---

<BaseLayout title={title} description={description} image={image} imageAlt={imageAlt}>
    <div class={cn('mx-auto flex min-h-screen flex-col')}>
        <div class='bg-background sticky top-0 z-100 w-full md:hidden'>
            <MobileNav segment={segment} client:load />
        </div>
        <div
            class={cn(
                'border-line mx-auto flex w-full max-w-5xl flex-1 flex-col md:relative md:min-h-screen md:flex-row md:border-r'
            )}
        >
            <aside
                class={cn(
                    'no-scrollbar flex min-w-0 flex-1 flex-col md:h-full md:min-h-screen',
                    'md:border-line md:border-x'
                )}
            >
                <main
                    class={cn('flex-1 md:min-h-0 md:pt-8', mainClass)}
                    data-disable-theme-toggle-transition
                >
                    <slot />
                </main>
            </aside>
            <RightSection />
            <SoundEffect />
        </div>
    </div>
</BaseLayout>
