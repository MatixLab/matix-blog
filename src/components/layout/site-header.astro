---
import Link from '@components/common/Link.astro'
import { cn } from '@utils/tv'
import { Asterisk } from 'lucide-react'

type Props = {
    className?: string
}

const { className } = Astro.props
---

<div class={cn('bg-background z-50 h-12', className)}>
    <div class='relative container size-full items-center space-x-12'>
        <div class='hidden items-center gap-6 md:flex md:gap-8 lg:gap-10'>
            <Link href='/' class='items-center space-x-2' title='Home'>
                <Asterisk className='size-8' />
            </Link>
        </div>

        <div class='mx-auto hidden md:flex'>
            <!-- normal nav menu -->
            <slot name='nav-header' />
        </div>

        <!-- Theme Toggle -->
        <slot name='right-header' />
    </div>
</div>
