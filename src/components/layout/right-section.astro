---
import { Icon } from 'astro-icon/components'
import { GitBranch, GitCommit, GitCommitVertical, GitMerge } from 'lucide-react'
import { links } from '@/config/menu'
import { siteConfig } from '@/config/site'
import { extractSegmentURL } from '@/lib/utils'
import type { MainNavItem } from '@/types'
import { cn } from '@/utils/tv'
import Link from '../common/Link.astro'

const segment = extractSegmentURL(Astro.url.pathname)

const gitHash = PUBLIC_GIT_REVISION_INFO.slice(0, 7)
---

<div class='no-scrollbar hidden w-64 shrink-0 flex-col gap-6 md:grid md:grid-rows-[auto_1fr_auto] lg:h-full lg:overflow-y-auto'>
    <section class='pt-6' id='top-section'>
        <div class='flex flex-col gap-6'>
            <!-- <Link href='/' class='items-center' title='Home'>
                <Icon name='lucide:asterisk' class='size-6' />
            </Link> -->
            <strong>{siteConfig.author}</strong>
            <span class='text-muted-foreground/65 select-none'>
                {siteConfig.slogan}
            </span>
        </div>
    </section>

    <div></div>

    <section class='flex flex-col gap-6 pb-6' id='footer-section'>
        <ul class='flex flex-col items-start gap-2'>
            {links.map((item: MainNavItem) => (
                <li class='relative list-none'>
                    <Link
                        href={item.href}
                        title={item.title}
                        class={cn(
                            'text-sm transition-all duration-500 ease-linear hover:text-black',
                            item.href.startsWith(`/${segment}`)
                                ? 'text-black dark:text-white'
                                : 'text-gray-400'
                        )}
                    >
                        {item.title}
                    </Link>
                </li>
            ))}
        </ul>

        <div>ThemeToggle</div>
        <div class='flex h-5 space-x-2'>
            <Link
                class='common-link text-muted-foreground hover:text-foreground flex items-center gap-1.5 text-xs'
                href='/rss.xml'
                title='RSS'
            >
                <Icon name='lucide:rss' class='size-4' />
            </Link>

            <Link
                class='link text-muted-foreground hover:text-foreground flex items-center gap-1 text-sm'
                href={siteConfig.repoUrl}
                title='matix-blog'
            >
                <GitMerge className='size-4' /> {gitHash}
            </Link>
        </div>
    </section>
</div>
