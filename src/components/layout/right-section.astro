---
import Link from '@components/common/Link.astro'
import ThemeToggle from '@components/common/theme-toggle.astro'
import { MapDot } from '@components/icons'
import Nav from '@components/layout/nav.astro'
import { siteConfig } from '@config/site'
import { trimTrailingSlash } from '@lib/utils'
import { Bot, GitMerge, Rss } from 'lucide-react'
import { cn } from 'tailwind-variants'
---

<div class={cn(
    'no-scrollbar hidden w-[calc(var(--right-section-half-width)+var(--right-section-half-width))] shrink-0 flex-col gap-6 px-4 md:grid-rows-[auto_1fr_auto] lg:grid lg:h-full',
    Astro.url.pathname === '/' ? 'pt-9' : 'pt-8',
    // 'right-section'
)}>
    <section id='top-section'>
        <div class='flex flex-col gap-6'>
            <div class='flex flex-row gap-2'>
                <strong>{siteConfig.author}</strong>
                <Link href='/' linkType='unset' class='my-auto flex items-center gap-2'>
                    <span class='size-4 rounded-full bg-orange-600'></span>
                </Link>
            </div>
            <span class='text-muted-foreground/65 text-sm select-none'>
                {siteConfig.slogan}
            </span>
        </div>
    </section>

    <div></div>
    <section class='flex flex-col gap-6 pb-12' id='footer-section'>
        <Nav />
        <ThemeToggle />
        <div class='flex flex-col gap-2'>
            <div class='text-muted-foreground flex h-5 gap-2'>
                <Link class='hover:text-foreground text-xs' href='/rss.xml' title='RSS'>
                    <Rss className='size-4' />
                </Link>
                <Link class='hover:text-foreground text-xs' href='/llms.txt' title='LLMS'>
                    <Bot className='size-4' />
                </Link>
                <Link
                    class='hover:text-foreground text-xs'
                    href={`${trimTrailingSlash(siteConfig.repoUrl)}/commit/${PUBLIC_GIT_REVISION_INFO}`}
                    type='icon'
                    title='matix-blog'
                >
                    <GitMerge className='size-4' />
                </Link>
            </div>
            <div class='text-muted-foreground group/site flex gap-1.5 text-xs'>
                <MapDot className='group-hover/site:animate-icon-bounce group-hover/site:fill-accent fill-current' />
                Made in JiangSu, CN
            </div>
        </div>
    </section>
</div>

<style>
    @media (min-width: 64rem) {
        .right-section {
            position: relative;
        }

        .right-section::before {
            position: absolute;
            inset-block: -2rem;
            left: -1.75rem;
            width: 1px;
            background: var(--line);
            content: '';
            pointer-events: none;
        }
    }
</style>
