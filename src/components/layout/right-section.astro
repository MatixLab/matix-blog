---
import Link from '@components/common/Link.astro'
import ThemeToggle from '@components/common/theme-toggle.astro'
import Nav from '@components/layout/nav.astro'
import { Bot, GitMerge, Rss } from 'lucide-react'
import { siteConfig } from '@config/site'
import { trimTrailingSlash } from '@lib/utils'
import type { MainNavItem } from '~types/index'
import { MapDot } from '@components/icons'

export const links: MainNavItem[] = [
    { href: '/post/', title: 'Posts' },
    { href: '/uses/', title: 'Uses' },
    { href: '/now/', title: 'Now' },
    { href: '/collective/', title: 'Collective' },
    { href: '/credits/', title: 'Credits' }
]
---

<div class='no-scrollbar hidden w-64 shrink-0 flex-col gap-6 md:grid-rows-[auto_1fr_auto] lg:grid lg:h-full lg:overflow-y-auto'>
    <section class='pt-6' id='top-section'>
        <div class='flex flex-col gap-6'>
            <Link href='/'>
                <strong>{siteConfig.author}</strong>
            </Link>
            <span class='text-muted-foreground/65 text-sm select-none'>
                {siteConfig.slogan}
            </span>
        </div>
    </section>

    <div></div>
    <section class='flex flex-col gap-6 pb-12' id='footer-section'>
        <Nav />
        <ThemeToggle />
        <div class='flex flex-col gap-2'>
            <div class='text-muted-foreground flex h-5 gap-2'>
                <Link
                    class='hover:text-foreground text-xs'
                    href='/rss.xml'
                    title='RSS'
                >
                    <Rss className='size-4' />
                </Link>
                <Link
                    class='hover:text-foreground text-xs'
                    href='/llms.txt'
                    title='LLMS'
                >
                    <Bot className='size-4' />
                </Link>
                <Link
                    class='hover:text-foreground text-xs'
                    href={`${trimTrailingSlash(siteConfig.repoUrl)}/commit/${PUBLIC_GIT_REVISION_INFO}`}
                    title='matix-blog'
                >
                    <GitMerge className='size-4' />
                </Link>
            </div>
            <div class='text-muted-foreground group/site flex gap-1.5 text-xs'>
                <MapDot className='group-hover/site:animate-icon-bounce group-hover/site:fill-accent fill-current' />
                Made in JiangSu, CN
            </div>
        </div>
    </section>
</div>
