---
import type { HTMLAttributes } from 'astro/types'
import { cn } from '@/utils/tv'

type Props = Omit<HTMLAttributes<'div'>, 'class'> & {
    className?: string
}

const { className, ...attrs } = Astro.props
---

<div
    class={cn(
        'relative container flex w-full max-w-6xl flex-col',
        className
    )}
    {...attrs}
>
    <slot />
</div>
