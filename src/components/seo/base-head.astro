---
import BaseFont from '@components/seo/base-font.astro'
import BaseScript from '@components/seo/base-script.astro'
import BaseCanonical from '@components/seo/canonical.astro'
import BaseOg from '@components/seo/og.astro'
import '@base/src/styles/global.css'
import { siteConfig } from '@config/site'
import { ClientRouter } from 'astro:transitions'

type Props = {
    title: string
    description?: string
    image?: string
    imageAlt?: string
}
const { title, description, image, imageAlt } = Astro.props
const { mode: defaultMode } = siteConfig.color
---

<head>
    <meta charset='utf-8' />
    <meta
        name='viewport'
        content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover'
    />
    <meta name='color-scheme' content='light dark' />
    <link rel='icon' href='/favicon.svg' type='image/svg+xml' />
    <title>{title ? `${title} | ${siteConfig.author}` : siteConfig.author}</title>
    <meta name='generator' content={Astro.generator} />
    <meta
        name='title'
        content={title ? `${title} | ${siteConfig.author}` : siteConfig.author}
    />
    <meta name='description' content={description} />
    <meta name='author' content={siteConfig.author} />
    <BaseCanonical />
    <BaseOg
        title={title}
        description={description}
        image={image}
        imageAlt={imageAlt}
    />
    <BaseFont />
    <script
        is:inline
        define:vars={{
            defaultMode
        }}
    >
        ;(function () {
            function isCurrentDark() {
                const currentTheme = localStorage.getItem('theme')
                if (currentTheme) {
                    return currentTheme === 'dark'
                }

                if (defaultMode !== 'auto') {
                    return defaultMode === 'dark'
                }

                return window.matchMedia('(prefers-color-scheme: dark)').matches
            }

            function initTheme(doc = document) {
                const isDark = isCurrentDark()
                doc.documentElement.classList.toggle('dark', isDark)
            }

            function initMotionPref(doc = document) {
                const prefersReducedMotion = window.matchMedia(
                    '(prefers-reduced-motion: reduce)'
                ).matches
                const supportsViewTransitions = 'startViewTransition' in doc
                const shouldReduceMotion =
                    prefersReducedMotion || !supportsViewTransitions

                doc.documentElement.classList.toggle(
                    'reduce-motion',
                    shouldReduceMotion
                )
            }

            document.addEventListener('astro:before-swap', ({ newDocument }) => {
                initTheme(newDocument)
                initMotionPref(newDocument)
            })

            // Initialize theme on first load
            initTheme()
            initMotionPref()
        })()
    </script>

    <BaseScript />
    <ClientRouter fallback='none' />
</head>
