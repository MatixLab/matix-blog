---
export interface Props {
    currentPage: number
    totalPages: number
    prevUrl: string
    nextUrl: string
}

const { currentPage, totalPages, prevUrl, nextUrl } = Astro.props

const prev = currentPage > 1 ? '' : 'disabled'
const next = currentPage < totalPages ? '' : 'disabled'
const getTransitionName = (href: string) => {
    const { pathname } = new URL(href, Astro.url)
    const pathIdentifier = Array.from(pathname, (character) => {
        const codePoint = character.codePointAt(0)
        if (codePoint === undefined) {
            throw new Error('Unable to generate pagination transition name')
        }

        return codePoint.toString(16)
    }).join('-')

    return `pagination-${pathIdentifier}`
}
---

<div class='mt-8'>
    {totalPages > 1 && (
        <nav aria-label='Pagination' class='flex gap-4 text-sm'>
            {prev === 'disabled' && <span aria-disabled>Prev</span>}
            {prev !== 'disabled' && (
                <a
                    aria-label='Prev'
                    data-astro-prefetch='viewport'
                    href={prevUrl}
                    style={`view-transition-name: ${getTransitionName(prevUrl)}`}
                >
                    <span>Prev</span>
                </a>
            )}
            <span style={`view-transition-name: ${getTransitionName(Astro.url.pathname)}`}>
                {currentPage}
            </span>{' '}
            / {totalPages}
            {next === 'disabled' && <span aria-disabled>Next</span>}
            {next !== 'disabled' && (
                <a
                    href={nextUrl}
                    aria-label='Next'
                    data-astro-prefetch='viewport'
                    style={`view-transition-name: ${getTransitionName(nextUrl)}`}
                >
                    <span>Next</span>
                </a>
            )}
        </nav>
    )}
</div>

<style>
    [aria-disabled] {
        opacity: 0.5;
        cursor: not-allowed;
    }
    a {
        color: inherit;
        text-decoration: none;
    }

    a:hover {
        color: #171717;
    }

    a > span {
        transition: 0.5s ease;
        border-bottom: 1px solid rgba(33, 33, 33, 0.2);
    }

    a:hover > span {
        border-bottom-color: #171717;
    }
</style>
