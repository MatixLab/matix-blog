---
import { CopyButton } from '@/components/markdown/CopyButton'
import { cn } from '@/lib/utils'

const props = Astro.props
---

<div class="copy-code-wrapper">
  <div class="code-header flex justify-between items-center px-1">
    <div class="code-filename flex items-center">
      <span class="mono small-text lh-1">title</span>
    </div>
    <div class="code-copy">
      {props.__rawString__ && (
        <CopyButton
          value={props.__rawString__}
          client:load
        />
      )}
    </div>
  </div>
  <pre
    data-lang={props.__meta__}
    class={cn(
    'flex max-h-[500px] overflow-x-auto w-full',
    props.class,
  )}
  >
    <slot />
  </pre>
</div>

