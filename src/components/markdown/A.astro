---
import { ArrowUpRight } from 'lucide-react'

const { props } = Astro
---

<a
    href={`${props.href}?ref=antzhu.com`}
    title={props.title}
    class:list={[
        'text-gray-1000 after:text-gray-1000 pl-0! break-words no-underline',
        props.class
    ]}
    {...props}
    style={{ ...props?.style }}
>
    <span class:list={['common-link link-animate font-normal hover:text-black']}>
        <slot />
    </span>
    {props['aria-label'] || props.href.startsWith('/') ? null : (
        <ArrowUpRight className='-mt-0.5 inline-flex size-4 shrink-0 p-0.5 text-gray-700' />
    )}
</a>
