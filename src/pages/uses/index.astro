---
import Link from '@components/common/Link.astro'
import MainLayout from '@layouts/main-layout.astro'
import { Icon } from 'astro-icon/components'
import type { UsingItem } from '@/types'
import { uses } from './_data'

const useTypes = Object.keys(uses)
---

<MainLayout
    title='Uses'
    description='Things of Choice.'
>
    <section class='prose dark:prose-invert container max-w-[948px] px-4 py-3 md:px-16'>
        <h1 class='scroll-m-20 pt-4 text-3xl font-bold md:pt-8'>
            Things of Choice.
        </h1>
        <article class='relative flex flex-col overflow-auto'>
            {useTypes.map((type) => {
                return (
                    <>
                        <h2 class='mt-0 mb-0 scroll-m-20 text-2xl font-semibold'>
                            {type}
                        </h2>
                        <ul class='ml-1 list-disc'>
                            {uses[type].map((item: UsingItem) => {
                                return item.url ? (
                                    <li class='mt-2'>
                                        {item.desc && (
                                            <span class='text-gray-1000 pr-1 text-[15px]'>
                                                {item.desc} :{' '}
                                            </span>
                                        )}
                                        <Link
                                            href={`${item.url}?ref=antzhu.com`}
                                            title={item.title}
                                            class='pl-0! break-words no-underline'
                                        >
                                            <h3 class='common-link link-animate mt-0 mb-0 inline-flex text-base leading-[2] font-medium text-black!'>
                                                {item.title}
                                            </h3>
                                            <Icon
                                                name='lucide:arrow-up-right'
                                                class='-mt-0.5 inline-flex size-4 shrink-0 p-0.5 text-gray-700'
                                            />
                                        </Link>
                                    </li>
                                ) : (
                                    <li class='mt-2'>
                                        {item.desc && (
                                            <span class='text-gray-1000 pr-1 text-[15px]'>
                                                {item.desc} :{' '}
                                            </span>
                                        )}
                                        <span class='text-gray-1000 pl-0! text-base font-medium'>
                                            {item.title}
                                        </span>
                                    </li>
                                )
                            })}
                        </ul>
                    </>
                )
            })}
        </article>
    </section>
</MainLayout>
