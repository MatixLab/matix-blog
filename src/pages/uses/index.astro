---
import {
    getDefaultUseType,
    getUses,
    getUseTypes
} from '@lib/fetchers'
import UseTypeList from './_components/use-type-list.astro'
import UsesLayout from './_layout/uses-layout.astro'

const allUses = await getUses()
const types = getUseTypes(allUses)
const type = getDefaultUseType(allUses)
const uses = allUses.filter((item) => item.data.type === type)
---

<UsesLayout title='Uses' description='Things of Choice.'>
    <div slot='right-content'>
        <div class='pt-4'>
            <UseTypeList type={type} types={types} uses={uses} />
        </div>
    </div>
</UsesLayout>
