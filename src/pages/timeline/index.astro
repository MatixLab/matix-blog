---
import type { CollectionEntry } from 'astro:content'
import IMG from '@/components/markdown/IMG.astro'
import { MdxComponents } from '@/components/markdown/mdx-components'
import Pre from '@/components/markdown/Pre.astro'
import MainLayout from '@/layouts/MainLayout.astro'
import { formatSimpleDate } from '@/lib/utils'
import { getCollection, render } from 'astro:content'

const timeline = await getCollection('timeline')

const timelineData: {
  [prop: string]: CollectionEntry<'timeline'>[]
} = {}

timeline.forEach((item) => {
  const year = item.data.pubDate.getFullYear()
  if (!timelineData[year]) {
    timelineData[year] = []
  }
  timelineData[year].push(item)
})
const years = Object.keys(timelineData).sort((a, b) => {
  return Number(b) - Number(a)
})

---

<MainLayout
  title="Timeline"
>
  <section class="container max-w-[948px] space-y-6 pt-12">
    {
      years.length
      ? (
        <div class="flex flex-col items-stretch gap-12">
          {
            years.map((year) => {
              return (
                <div class="flex flex-col items-baseline gap-6 md:flex-row md:gap-12">
                  <div class="flex items-center">
                    <span class="text-3xl font-bold items-center">{year}</span>
                    <hr class="my-0 ml-4 flex-1 border-dashed border-gray-200" />
                  </div>
                  <section>
                    {
                      timelineData[year].map((line, index) => {
                        return (
                          <div class="relative flex pb-8 last:pb-0">
                            {
                              (index !== timelineData[year].length - 1)
                              ? (
                                <div class="absolute inset-0 flex w-6 items-center justify-center">
                                  <div class="pointer-events-none h-full w-px border-l border-gray-200" />
                                </div>
                              )
                              : null
                            }
                            <div class="rounded-md p-1 bg-ds-gray-1000 text-ds-gray-100 text-sm">
                              { formatSimpleDate(line.data.pubDate) }
                            </div>
                            <div class="grow pl-8">
                              <div class="word-break-word flex flex-col">
                                {
                                  render(line).then(({ Content }) => (
                                    <Content
                                      components={{
                                        ...MdxComponents,
                                        img: IMG,
                                        Image: IMG,
                                        pre: Pre,
                                      }}
                                    />
                                  ))
                                }
                              </div>
                            </div>
                          </div>
                        )
                      })
                    }
                  </section>
                </div>
              )
            })
          }
        </div>
      )
      : null
    }
    <div class="flex flex-col items-baseline gap-6 md:flex-row md:gap-12">

    </div>
  </section>
</MainLayout>
