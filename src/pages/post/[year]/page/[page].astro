---
import { getPosts, getPostYears, groupPostsByYear } from '@lib/fetchers'
import { getPostPaginationPaths } from '@lib/post-pagination'
import type { PostListPagination } from '@lib/post-pagination'
import type { CollectionEntry } from 'astro:content'
import YearPostList from '../../_components/year-post-list.astro'
import BlogLayout from '../../_layout/blog-layout.astro'

export async function getStaticPaths() {
    const postsByYear = groupPostsByYear(await getPosts())
    const years = getPostYears(postsByYear)

    return Object.entries(postsByYear).flatMap(([year, posts]) =>
        getPostPaginationPaths(posts, `/post/${year}`, { year }).map(({ params, props }) => ({
            params,
            props: { ...props, year, years }
        }))
    )
}

type Props = {
    posts: CollectionEntry<'post'>[]
    pagination: PostListPagination
    years: string[]
    year: string
}

const { posts, pagination, years, year } = Astro.props
const { page = '2' } = Astro.params
---

<BlogLayout title={`Posts in ${year} · ${page}`} description='Writing record.'>
    <div slot='right-content'>
        <div class='pt-4'>
            <YearPostList year={year} years={years} posts={posts} pagination={pagination} />
        </div>
    </div>
</BlogLayout>
