---
import { getDefaultPostYear, getPosts, getPostYears, groupPostsByYear } from '@lib/fetchers'
import { paginatePosts } from '@lib/post-pagination'
import PostListPage from './_components/post-list-page.astro'

const allPosts = await getPosts()
const postsByYear = groupPostsByYear(allPosts)
const years = getPostYears(postsByYear)
const year = getDefaultPostYear(postsByYear)
const { posts, pagination } = paginatePosts(postsByYear[year] ?? [], 1, '/post')
---

<PostListPage
    title='Posts'
    description='Writing record.'
    year={year}
    years={years}
    posts={posts}
    pagination={pagination}
/>
