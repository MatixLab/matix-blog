---
import MainLayout from '@layouts/main-layout.astro'

type Props = {
    title: string
    description?: string
    mainClass?: string
}

const { title, description, mainClass } = Astro.props
---

<MainLayout title={title} description={description} mainClass={mainClass}>
    <section class='container px-4 py-3'>
        <slot name='head-name'>
            <h1 class='scroll-m-20 pt-4 text-3xl font-bold md:pt-8'>{description}</h1>
        </slot>
        <section class='relative flex flex-col overflow-auto'>
            <slot name='right-content' />
        </section>
    </section>
</MainLayout>
