---
import { getPosts, getPostYears, groupPostsByYear } from '@lib/fetchers'
import { paginatePosts } from '@lib/post-pagination'
import type { CollectionEntry } from 'astro:content'
import YearPostList from './_components/year-post-list.astro'
import BlogLayout from './_layout/blog-layout.astro'

export async function getStaticPaths() {
    const allPosts = await getPosts()
    const postsByYear = groupPostsByYear(allPosts)
    const years = getPostYears(postsByYear)

    return Object.entries(postsByYear).map(([year, posts]) => ({
        params: { year },
        props: { posts, years }
    }))
}

type Props = {
    posts: CollectionEntry<'post'>[]
    years: string[]
}

const { posts, years } = Astro.props
const { year = '' } = Astro.params
const paginatedPosts = paginatePosts(posts, 1, `/post/${year}`)
---

<BlogLayout title={`Posts in ${year}`} description='Writing record.'>
    <div slot='right-content'>
        <div class='pt-4'>
            <YearPostList
                year={year}
                years={years}
                posts={paginatedPosts.posts}
                pagination={paginatedPosts.pagination}
            />
        </div>
    </div>
</BlogLayout>
