---
import { getDefaultPostYear, getPosts, getPostYears, groupPostsByYear } from '@lib/fetchers'
import type { CollectionEntry } from 'astro:content'
import YearPostList from '../../_components/YearPostList.astro'
import BlogLayout from '../../_layout/BlogLayout.astro'

export async function getStaticPaths() {
    const allPosts = await getPosts()
    const categories = [...new Set(allPosts.flatMap((post) => post.data.category))]

    return categories.map((category) => ({
        params: { category },
        props: {
            posts: allPosts.filter((post) => post.data.category.includes(category))
        }
    }))
}

type Props = {
    posts: CollectionEntry<'post'>[]
}

const { category = '' } = Astro.params
const { posts: categoryPosts } = Astro.props
const postsByYear = groupPostsByYear(categoryPosts)
const years = getPostYears(postsByYear)
const year = getDefaultPostYear(postsByYear)
const posts = postsByYear[year] ?? []
---

<BlogLayout title={`${category}`} description={`All posts for ${category}`}>
    <div slot='right-content'>
        <div class='pt-4'>
            <YearPostList
                basePath={`/post/category/${category}`}
                year={year}
                years={years}
                posts={posts}
            />
        </div>
    </div>
</BlogLayout>
