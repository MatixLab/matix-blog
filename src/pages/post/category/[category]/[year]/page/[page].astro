---
import { getPosts, getPostYears, groupPostsByYear } from '@lib/fetchers'
import { getPostPaginationPaths } from '@lib/post-pagination'
import type { PostListPagination } from '@lib/post-pagination'
import type { CollectionEntry } from 'astro:content'
import YearPostList from '../../../../_components/year-post-list.astro'
import BlogLayout from '../../../../_layout/blog-layout.astro'

export async function getStaticPaths() {
    const allPosts = await getPosts()
    const categories = [...new Set(allPosts.flatMap((post) => post.data.category))]

    return categories.flatMap((category) => {
        const categoryPosts = allPosts.filter((post) => post.data.category.includes(category))
        const postsByYear = groupPostsByYear(categoryPosts)
        const years = getPostYears(postsByYear)

        return Object.entries(postsByYear).flatMap(([year, posts]) =>
            getPostPaginationPaths(posts, `/post/category/${category}/${year}`, {
                category,
                year
            }).map(({ params, props }) => ({
                params,
                props: { ...props, year, years }
            }))
        )
    })
}

type Props = {
    posts: CollectionEntry<'post'>[]
    pagination: PostListPagination
    years: string[]
    year: string
}

const { posts, pagination, years, year } = Astro.props
const { category = '', page = '2' } = Astro.params
---

<BlogLayout
    title={`${category} in ${year} · ${page}`}
    description={`All posts for ${category}`}
>
    <div slot='right-content'>
        <div class='pt-4'>
            <YearPostList
                basePath={`/post/category/${category}`}
                year={year}
                years={years}
                posts={posts}
                pagination={pagination}
            />
        </div>
    </div>
</BlogLayout>
