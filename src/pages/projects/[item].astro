---
import A from '@/components/markdown/A.astro'
import { MdxComponents } from '@/components/markdown/mdx-components'
import MainLayout from '@/layouts/MainLayout.astro'
import { getProjects } from '@/lib/fetchers'
import { getEntry, render } from 'astro:content'

export async function getStaticPaths() {
  const projectData: {
    id: string
    name: string
  }[] = await getProjects()

  return projectData.map(project => {
    return {
      params: { item: project.id }
    }
  })
}

const { item } = Astro.params
const entry = await getEntry('projects', item)

if (!entry) {
  throw new Error(`Could not find project ${item}`)
}

const { Content } = await render(entry)
---

<MainLayout title={item} description={item}>
  <section
    class="prose container max-w-[948px] px-4 py-3 md:px-16 dark:prose-invert"
  >
    <h1 class="scroll-m-20 pt-4 text-3xl font-bold md:pt-8">
      {item}
    </h1>
    <article class="relative overflow-auto">
      <Content
        components={{
          ...MdxComponents,
          a: A
        }}
      />
    </article>
  </section>
</MainLayout>
