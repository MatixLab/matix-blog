---
import Link from '@/components/common/Link.astro'
import Tags from '@/components/common/Tags.astro'
import { Icon } from 'astro-icon/components'

interface Props {
  url: string
  title: string
  desc?: string
  tags?: string[],
  icon?: string
}
const { url, title, tags, desc, icon='' } = Astro.props
---

<div class="flex flex-col">
  <div class="flex justify-between">
    <Link
      href={`${url}?ref=antzhu.com`}
      title={title}
      class="break-words pl-0! no-underline"
    >
      <Icon
        name={`simple-icons:${icon}`}
        class="inline-flex size-4 p-0.5 shrink-0 text-ds-gray-700 -mt-0.5"
      />
      <h3
        class:list={[
          'inline-flex mt-0 mb-0 font-medium common-link link-animate text-base text-black!',
        ]}
      >
        {title}
      </h3>
      <Icon
        name="lucide:arrow-up-right"
        class="inline-flex size-4 p-0.5 shrink-0 text-ds-gray-700 -mt-0.5"
      />
    </Link>
    <span class="items-center ml-1 hidden md:flex space-x-2">
      <Tags tags={tags || []} />
    </span>
  </div>
  <div class="text-ds-gray-800 text-sm ml-2">
    {desc}
  </div>
</div>
