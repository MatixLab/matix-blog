---
import Link from '@/components/common/Link.astro'
import Tags from '@/components/common/Tags.astro'
import { Icon } from 'astro-icon/components'

interface Props {
  url: string
  title: string
  desc?: string
  tags?: string[]
}
const { url, title, tags, desc } = Astro.props
---

<div class="flex flex-col pb-2">
  <div class="flex justify-between">
    <Link
      href={`${url}?ref=antzhu.com`}
      title={title}
      class="break-words text-black !pl-0 !no-underline"
    >
      <h3
        class:list={[
          'inline-flex my-0 font-normal text-lg common-link link-animate !text-ds-gray-1000',
        ]}
      >
        {title}
      </h3>
      <Icon
        name="lucide:arrow-up-right"
        class="inline-flex size-4 p-0.5 shrink-0 text-ds-gray-700 -mt-1"
      />
    </Link>
    <span class="items-center ml-1 hidden md:flex space-x-2">
      <Tags tags={tags || []} />
    </span>
  </div>
  <div class="text-ds-gray-800 text-sm">
    {desc}
  </div>
</div>
