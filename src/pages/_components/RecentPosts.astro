---
import Link from '@components/common/Link.astro'
import { siteConfig } from '@config/site'
import { getPosts } from '@lib/fetchers'
import { formatDateWithYear } from '@lib/utils'

let allPosts = await getPosts()
allPosts = allPosts.slice(0, siteConfig.home.displayNumber)
---

<div class='space-y-4'>
    <div class='flex justify-between px-2 align-middle'>
        <h2 class='font-semibold'>Recent &nbsp; Post</h2>
        <div class='text-end md:text-start'>
            {allPosts.length ? (
                <>
                    <Link href='/post/' title='View all posts' class='link text-xs'>
                        View all
                    </Link>
                    <Link href='/post.xml' title='Feed post rss' class='link ml-2 text-xs'>
                        Rss
                    </Link>
                </>
            ) : null}
        </div>
    </div>
    <div class='space-y-1'>
        {allPosts.length ? (
            <div class='text-[15px]'>
                <div class='group/list-wrapper'>
                    <ul class='space-y-4'>
                        {allPosts.map((item) => {
                            return (
                                <li class='group/list-item group-hover/list-wrapper:text-muted-foreground/35 grid px-2'>
                                    <div class='group-hover/list-item:text-accent flex justify-between'>
                                        <Link
                                            title={item.data.title}
                                            href={`/post/${item.id}/`}
                                            class='col-span-2 line-clamp-1'
                                            linkType='unset'
                                        >
                                            {item.data.title}
                                        </Link>
                                        <time datetime={item.data.pubDate.toDateString()}>
                                            {formatDateWithYear(item.data.pubDate)}
                                        </time>
                                    </div>
                                </li>
                            )
                        })}
                    </ul>
                </div>
            </div>
        ) : (
            <div class='flex size-full items-center text-center text-sm'>
                That's all for now. Come back later for more.
            </div>
        )}
    </div>
</div>
