---
import Link from '@components/common/Link.astro'
import Container from '@components/shared/container.astro'
import { getCredits } from '@lib/fetchers'
import type { CommonItem } from '~types/index'

const credits: Record<string, CommonItem[]> = getCredits()

type Column = {
    label: string
    items: CommonItem[]
    span?: 2
    showVersion?: boolean
}

const topColumns: Column[] = [
    { label: 'Packages', items: credits['Packages'], span: 2, showVersion: true },
    { label: 'Date', items: credits['Date'] },
    { label: 'Deployed on', items: credits['Deployed on'] }
]

const bottomColumns: Column[] = [
    { label: 'License', items: credits['License'] },
    { label: 'For Agents', items: credits['Agents'] },
    { label: 'Typeface', items: credits['Typeface'] },
    { label: 'Inspired by', items: credits['Inspired by'] }
]
---

<Container
    className='text-muted-foreground/45 border-line border-y py-2 font-mono text-sm font-light select-none'
    as='p'
    role={'img'}
>
    {`[Credits]`}
</Container>

<div class='border-line relative border-b'>
    <dl class='max-sm:divide-line grid grid-cols-2 gap-px font-mono max-sm:gap-y-0 max-sm:divide-y sm:grid-cols-4'>
        {topColumns.map(({ label, items, span, showVersion }, index) => (
            <Container
                className={`flex min-w-0 flex-col gap-2 py-3 max-sm:col-span-2 ${span === 2 ? 'sm:col-span-2' : ''} ${index < 2 ? 'sm:border-line sm:border-r' : ''}`}
            >
                <dt class='text-muted-foreground text-[13px]/4 font-medium uppercase'>
                    {label}
                </dt>
                <dd class='flex-1 space-y-1 text-[13px]/4'>
                    {items.map((x) => {
                        const title = showVersion ? `${x.title}${x.version ?? ''}` : x.title
                        return x.url ? (
                            <Link href={x.url} class='w-full'>
                                {title}
                            </Link>
                        ) : (
                            <p>{title}</p>
                        )
                    })}
                </dd>
            </Container>
        ))}
    </dl>
</div>

<div class='border-line relative border-b'>
    <dl class='grid grid-cols-2 gap-px font-mono sm:grid-cols-4'>
        {bottomColumns.map(({ label, items }, index) => (
            <Container
                className={`flex min-w-0 flex-col gap-2 py-3 ${index < bottomColumns.length - 1 ? 'sm:border-line sm:border-r' : ''} ${index % 2 === 1 ? 'border-line max-sm:border-l' : ''}`}
            >
                <dt class='text-muted-foreground text-[13px]/4 font-medium uppercase'>
                    {label}
                </dt>
                <dd class='flex-1 space-y-1 text-[13px]/4'>
                    {items.map((x) =>
                        x.url ? (
                            <Link href={x.url} class='w-full'>
                                {x.title}
                            </Link>
                        ) : (
                            <p>{x.title}</p>
                        )
                    )}
                </dd>
            </Container>
        ))}
    </dl>
</div>
