---
import Link from '@components/common/Link.astro'
import { Bluesky, GitHub, X } from '@components/icons'
import { siteConfig } from '@config/site'
import { Mail } from 'lucide-react'
---

<div class='home-intro space-y-4 px-2'>
    <div>
        Hey 👋 I'm {siteConfig.author}, a full stack developer at
        <Link
            href='https://www.oki.com/'
            title='OKI'
            class='link text-muted-foreground ml-2'
        />
        .
    </div>
    <div>
        Previously, I was a developer at
        <Link
            href='https://www.winning.com.cn/'
            title='WinningHealth'
            class='link text-muted-foreground ml-2'
        />
        in ChangZhou. You can see what I'm up to on
        <Link href='/now/' title='my now page' class='link text-muted-foreground ml-2' />.
    </div>

    <div class='space-y-3 pt-4'>
        <div class='text-muted-foreground text-sm'>You can also find me on:</div>
        <div class='flex gap-2'>
            <Link
                href={siteConfig.links.github}
                title='Github'
                type='icon'
                class='hover:bg-secondary group flex size-9 items-center justify-center transition-colors'
            >
                <GitHub className='size-4 opacity-60 transition-opacity group-hover:opacity-100' />
            </Link>
            <Link
                href={siteConfig.links.twitter}
                title='x'
                type='icon'
                class='hover:bg-secondary group flex size-9 items-center justify-center transition-colors'
            >
                <X className='size-4 opacity-60 transition-opacity group-hover:opacity-100' />
            </Link>
            <Link
                href={siteConfig.links.blueSky}
                title='blueSky'
                type='icon'
                class='hover:bg-secondary group flex size-9 items-center justify-center transition-colors'
            >
                <Bluesky className='size-4 opacity-60 transition-opacity group-hover:opacity-100' />
            </Link>
            <!-- <Link href={siteConfig.links.notion} title='notion' type='icon'>
                    <Notion
                        name='simple-icons:notion'
                        class='inline-flex size-5 opacity-50 hover:opacity-100'
                    />
                </Link> -->
            <Link
                href={`mailto:${siteConfig.links.email}`}
                title='email'
                type='icon'
                class='hover:bg-secondary group flex size-9 items-center justify-center transition-colors'
            >
                <Mail className='size-4 opacity-60 transition-opacity group-hover:opacity-100' />
            </Link>
        </div>
    </div>
</div>
