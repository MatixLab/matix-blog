---
import Link from '@components/common/Link.astro'
import { Icon } from 'astro-icon/components'
import type { CreditItem } from '@/types'

interface Props {
    credits: CreditItem[]
}
const { credits } = Astro.props
---

{credits.map((item: CreditItem) => {
    return (
        <li class='mt-2'>
            <span class='text-gray-1000 text-[15px]'>{item.desc} </span>
            <Link
                href={`${item.url}?ref=antzhu.com`}
                title={item.title}
                class='break-words no-underline'
            >
                <h3 class='common-link link-animate mt-0 mb-0 inline-flex text-base leading-[2] font-medium text-black!'>
                    {item.title}
                </h3>
                <Icon
                    name='lucide:arrow-up-right'
                    class='-mt-0.5 inline-flex size-4 shrink-0 p-0.5 text-gray-700'
                />
            </Link>
        </li>
    )
})}
