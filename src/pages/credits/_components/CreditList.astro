
---
import type { CreditItem } from '@/types'
import Link from '@/components/common/Link.astro'
import { Icon } from 'astro-icon/components'

interface Props {
  credits: CreditItem[]
}
const { credits } = Astro.props

---

{
  credits.map((item: CreditItem) => {
    return (
    <li class="mt-2">
      <span class="text-[15px] text-ds-gray-1000">{item.desc} </span>
      <Link
        href={`${item.url}?ref=antzhu.com`}
        title={item.title}
        class="break-words no-underline"
      >
        <span class="text-[15px] common-link link-animate !text-ds-gray-1000">
          {item.title}
        </span>
        <Icon
          name="lucide:arrow-up-right"
          class="inline-flex size-4 p-0.5 shrink-0 text-ds-gray-700 -mt-1"
        />
      </Link>
    </li>
    )
  })
}
