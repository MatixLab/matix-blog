---
import { getCredits } from '@lib/fetchers'
import CreditList from './credit-list.astro'

const Inspiration = await getCredits('Inspiration')
---

<h2 class='mt-0 mb-2 scroll-m-20 text-2xl font-semibold'>Inspirations</h2>
<ul class='ml-1 list-disc'>
    <CreditList credits={Inspiration} />
</ul>
