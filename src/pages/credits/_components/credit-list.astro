---
import Link from '@components/common/Link.astro'
import type { CreditItem } from '~types/index'

interface Props {
    credits: CreditItem[]
}
const { credits } = Astro.props
---

{credits.map((item: CreditItem) => {
    return (
        <li>
            <span class='text-gray-1000 text-[15px]'>{item.desc} </span>
            <Link
                href={item.url ?? ''}
                title={item.title}
                class='wrap-break-word no-underline'
            >
                <h3 class='common-link link-animate mt-0 mb-0 inline-flex text-base leading-loose font-medium text-black!'>
                    {item.title}
                </h3>
            </Link>
        </li>
    )
})}
