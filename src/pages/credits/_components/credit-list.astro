---
import Link from '@components/common/Link.astro'
import type { Credit } from '@schemas/content.schema'
import type { CollectionEntry } from 'astro:content'

interface Props {
    credits: CollectionEntry<'credits'>[]
}
const { credits } = Astro.props
---

{credits.map((item: CollectionEntry<'credits'>) => {
    const { desc, url, id } = item.data
    return (
        <li>
            <span class='text-gray-1000 text-[15px]'>{desc} </span>
            <Link href={url ?? ''} title={id} class='wrap-break-word no-underline'>
                <h3 class='common-link link-animate mt-0 mb-0 inline-flex text-base leading-loose font-medium text-black!'>
                    {id}
                </h3>
            </Link>
        </li>
    )
})}
