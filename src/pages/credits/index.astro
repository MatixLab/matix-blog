---
import MainLayout from '@layouts/main-layout.astro'
import Colophon from './_components/colophon.astro'
import Inspirations from './_components/inspirations.astro'
---

<MainLayout title='Credits' description='Site Credits'>
    <section class='prose dark:prose-invert container max-w-237 space-y-4 px-4 py-3 md:px-16'>
        <h1 class='scroll-m-20 pt-4 text-3xl font-bold md:pt-8'>Site Credits.</h1>
        <article class='relative flex flex-col space-y-4 overflow-auto'>
            <Colophon />
            <Inspirations />
        </article>
    </section>
</MainLayout>
