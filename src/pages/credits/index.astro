---
import Heading from '@components/shared/heading.astro'
import MainLayout from '@layouts/main-layout.astro'
import Colophon from './_components/colophon.astro'
import Inspirations from './_components/inspirations.astro'
---

<MainLayout title='Credits' description='Site Credits'>
    <section class='prose dark:prose-invert container max-w-237 px-4'>
        <Heading as='h1' class='scroll-m-20 text-3xl font-bold'>
            Site Credits.
        </Heading>
        <div class='pt-4'>
            <article class='relative flex flex-col space-y-4 overflow-auto pl-6'>
                <Colophon />
                <Inspirations />
            </article>
        </div>
    </section>
</MainLayout>
