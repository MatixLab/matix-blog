---
import MainLayout from '@layouts/main-layout.astro'
import Colophon from './_components/colophon.astro'
import Inspirations from './_components/inspirations.astro'
---

<MainLayout title='Credits' description='Site Credits'>
    <section class='prose dark:prose-invert container max-w-237 px-6 py-3'>
        <h1 class='scroll-m-20 pt-4 text-3xl font-bold md:pt-8'>Site Credits.</h1>
        <div class='pt-4'>
            <div class='bg-muted my-4 h-px w-full' />
            <article class='relative flex flex-col space-y-4 overflow-auto pl-4'>
                <Colophon />
                <Inspirations />
            </article>
        </div>
    </section>
</MainLayout>
