---
import Link from '@components/common/Link.astro'
import MainLayout from '@layouts/main-layout.astro'
import { getCollection } from 'astro:content'

type CollectiveItem = {
    title: string
    subPath: string
}

const collectiveData: CollectiveItem[] = [
    { subPath: 'dev-sites', title: '开发者个人站' },
    { subPath: 'dev-china', title: '国内开发者个人站' }
]

const collectiveEntries = await getCollection('collective')

const collectiveItems = collectiveData.map((item) => {
    const entry = collectiveEntries.find(
        (collectiveEntry) => collectiveEntry.id === item.subPath
    )
    const count = entry?.body?.match(/^-\s+/gmu)?.length ?? 0
    return { ...item, count }
})
---

<MainLayout title='Collective' description='Collective records.'>
    <section class='prose dark:prose-invert container max-w-237 px-4 py-3'>
        <h1 class='scroll-m-20 pt-4 text-3xl font-bold md:pt-8'>Collective records.</h1>
        <div class='pt-4'>
            <div class='bg-muted my-4 h-px w-full' />
            <article class='relative flex flex-col overflow-auto'>
                <p class='mt-0 mb-4 scroll-m-20'>
                    如今很难找到优质的博客,因为很多都被 AI
                    生成的内容给淹没了。所以我创建了这个页面,收录了我喜欢的博客(必须由人类撰写)。
                </p>
                <div class='not-prose text-sm'>
                    <div class='group/list-wrapper'>
                        <ul class='divide-line border-line divide-y border-y'>
                            {collectiveItems.map((item) => {
                                return (
                                    <li class='group/list-item group-hover/list-wrapper:text-muted-foreground/35 grid px-2 py-3 before:hidden!'>
                                        <div class='group-hover/list-item:text-accent flex items-center justify-between'>
                                            <Link
                                                title={item.title}
                                                href={`/collective/${item.subPath}`}
                                                class='col-span-2 line-clamp-1'
                                                linkType='unset'
                                            >
                                                {item.title}
                                            </Link>
                                            <span class='tabular-nums'>{item.count}</span>
                                        </div>
                                    </li>
                                )
                            })}
                        </ul>
                    </div>
                </div>
            </article>
        </div>
    </section>
</MainLayout>
