---
import Link from '@components/common/Link.astro'
import MainLayout from '@layouts/main-layout.astro'

type CollectiveItem = {
    title: string
    subPath: string
}

const collectiveData: CollectiveItem[] = [
    { subPath: 'dev-sites', title: '开发者个人站' },
    { subPath: 'dev-china', title: '国内开发者个人站' }
]
---

<MainLayout title='Collective' description='Collective records.'>
    <section class='prose dark:prose-invert container max-w-237 space-y-4 px-4'>
        <h1 class='scroll-m-20 pt-4 text-3xl font-bold md:pt-8'>Collective records.</h1>
        <article class='relative flex flex-col overflow-auto'>
            <p class='mt-0 mb-2 scroll-m-20 text-gray-900'>
                如今很难找到优质的博客,因为很多都被 AI
                生成的内容给淹没了。所以我创建了这个页面,收录了我喜欢的博客(必须由人类撰写)。
            </p>
            <ul class='ml-1 list-disc'>
                {collectiveData.map((item: CollectiveItem) => {
                    return (
                        <li class='mt-2'>
                            <Link
                                href={`/collective/${item.subPath}`}
                                title={item.title}
                                class='pl-0! wrap-break-word no-underline'
                            >
                                <h3 class='mt-0 mb-0 inline-flex text-base leading-loose font-medium text-black!'>
                                    {item.title}
                                </h3>
                            </Link>
                        </li>
                    )
                })}
            </ul>
        </article>
    </section>
</MainLayout>
