---
import A from '@/components/markdown/A.astro'
import IMG from '@/components/markdown/IMG.astro'
import { MdxComponents } from '@/components/markdown/mdx-components'
import Pre from '@/components/markdown/Pre.astro'
import MainLayout from '@/layouts/MainLayout.astro'
import { Content } from './now.mdx'
---

<MainLayout
  title="Now"
  description="What I'm up to."
>
  <section class="prose dark:prose-invert container max-w-[948px] py-3 px-4 md:px-16">
    <h1 class="pt-4 md:pt-8 scroll-m-20 text-3xl font-bold">
      What I'm up to.
    </h1>
    <article class="overflow-auto relative flex flex-col">
      <Content
        components={{
        ...MdxComponents,
        img: IMG,
        Image: IMG,
        pre: Pre,
        a: A,
    }}
      />
    </article>
  </section>
</MainLayout>
