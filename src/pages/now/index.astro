---
import A from '@/components/markdown/A.astro'
import { MdxComponents } from '@/components/markdown/mdx-components'
import { Content } from '@/content/now.mdx'
import MainLayout from '@/layouts/MainLayout.astro'
---

<MainLayout title="Now" description="What I'm up to.">
  <section
    class="prose container max-w-[948px] px-4 py-3 md:px-16 dark:prose-invert"
  >
    <h1 class="scroll-m-20 pt-4 text-3xl font-bold md:pt-8">What I'm up to.</h1>
    <article class="relative overflow-auto">
      <Content
        components={{
          ...MdxComponents,
          a: A
        }}
      />
    </article>
  </section>
</MainLayout>
