---
import Link from '@components/common/Link.astro'
import { MdxComponents } from '@components/markdown/mdx-components'
import MainLayout from '@layouts/main-layout.astro'
import { Content } from '@content/now.mdx'
---

<MainLayout
    title='Now'
    description="What I'm up to."
>
    <section class='prose dark:prose-invert container max-w-[948px] px-4 py-3 md:px-16'>
        <h1 class='scroll-m-20 pt-4 text-3xl font-bold md:pt-8'>What I'm up to.</h1>
        <article class='relative overflow-auto'>
            <Content
                components={{
                    ...MdxComponents,
                    a: Link
                }}
            />
        </article>
    </section>
</MainLayout>
