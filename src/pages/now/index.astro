---
import Link from '@components/common/Link.astro'
import { MdxComponents } from '@components/markdown/mdx-components'
import Heading from '@components/shared/heading.astro'
import { Content } from '@content/now.mdx'
import MainLayout from '@layouts/main-layout.astro'
---

<MainLayout title='Now' description="What I'm up to.">
    <section class='prose dark:prose-invert container max-w-237 px-4'>
        <Heading as='h1' class='scroll-m-20 text-3xl font-bold'>
            What I'm up to.
        </Heading>
        <article class='relative overflow-auto pl-6'>
            <Content
                components={{
                    ...MdxComponents,
                    a: Link
                }}
            />
        </article>
    </section>
</MainLayout>
