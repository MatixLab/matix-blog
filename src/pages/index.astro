---
import { Line } from '@components/icons'
import Container from '@components/shared/container.astro'
import MainLayout from '@layouts/main-layout.astro'
import Intro from './_components/intro.astro'
import RecentPosts from './_components/recent-posts.astro'
---

<MainLayout title='About' description="Anthony's homepage" mainClass='lg:pt-4'>
    <Container className='pb-4'>
        <Intro />
    </Container>

    <div class='text-muted-foreground flex justify-center [&_svg]:h-5 [&_svg]:w-auto'>
        <Line />
    </div>

    <RecentPosts className='py-6' />

    <div class='screen-line-top h-6' aria-hidden='true' />

    <!-- <div class='text-muted-foreground flex justify-center [&_svg]:h-5 [&_svg]:w-auto'>
        <Line />
    </div> -->
</MainLayout>
