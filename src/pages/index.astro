---
import MainLayout from '@layouts/main-layout.astro'
import Intro from './_components/intro.astro'
import RecentPosts from './_components/recent-posts.astro'
---

<MainLayout title='About' description="Anthony's homepage">
    <div class='space-y-4 lg:mb-0'>
        <section class='relative py-5'>
            <Intro />
        </section>
        <div class='home-shadow h-6' aria-hidden='true'></div>
        <RecentPosts />
    </div>
</MainLayout>

<style>
    .home-shadow {
        position: relative;
    }

    .home-shadow::before {
        position: absolute;
        inset-block: 0;
        inset-inline: -1rem;
        border-block: 1px solid var(--line);
        background: repeating-linear-gradient(
            135deg,
            transparent 0,
            transparent 4px,
            color-mix(in oklch, var(--line) 70%, transparent) 4px,
            color-mix(in oklch, var(--line) 70%, transparent) 5px
        );
        content: '';
        pointer-events: none;
    }

    @media (min-width: 64rem) {
        .home-shadow::before {
            right: -1.75rem;
        }
    }
</style>
